#!/usr/bin/env bash
# Report the toolchain provided by the *loaded Nix environment* (devenv or nix-direnv).
#
# Versions are read from the store paths behind the profile's bin/ symlinks, so they
# describe what Nix actually put on PATH — never what a csproj, global.json,
# Directory.Build.props or package.json claims. It is also a pure filesystem walk:
# no `dotnet --version` / `pwsh --version` subprocesses, which matters because the
# tmux pane border re-runs this every 2 seconds.
#
# Usage: nix-toolchain [--tmux|--powerline] [--extra 'icon|label|value|colour']... [path]
#   (default)    dotnet 10.0.302 · node 24.18.0 · pwsh 7.6.3 · jdk 21.0.11
#   --tmux       coloured tmux status-bar segments, versions shortened
#   --powerline  agnoster-style ANSI segments for a shell banner (devenv enterShell)
#   --extra      append a segment for a tool Nix does NOT provide (npm global,
#                Homebrew cask, …) so a scope's banner stays one uniform bar.
#                Repeatable. Skipped when value is empty, so a missing tool simply
#                drops out rather than showing as blank.
#
# Prints nothing (exit 0) when no Nix environment is loaded for that path.

set -u

format="line"
extras=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --tmux)      format="tmux";      shift ;;
    --powerline) format="powerline"; shift ;;
    --extra)     extras+=("${2:-}");  shift 2 ;;
    *)           break ;;
  esac
done
start="${1:-$PWD}"

# ---------------------------------------------------------------- find profile
# Inside a devenv shell $DEVENV_PROFILE already points at it. Otherwise (tmux, which
# runs outside the shell) walk up from the pane's directory to the nearest built env.
profile=""
if [[ -n "${DEVENV_PROFILE:-}" && -d "$DEVENV_PROFILE/bin" ]]; then
  profile="$DEVENV_PROFILE"
else
  dir="$(cd "$start" 2>/dev/null && pwd -P)" || exit 0
  while :; do
    if [[ -d "$dir/.devenv/profile/bin" ]]; then
      profile="$dir/.devenv/profile"
      break
    fi
    # plain nix-direnv (`use flake` / `use nix`) keeps its profile under .direnv
    for candidate in "$dir"/.direnv/flake-profile-* "$dir"/.direnv/nix-profile-*; do
      if [[ -d "$candidate/bin" ]]; then
        profile="$candidate"
        break 2
      fi
    done
    [[ "$dir" == "/" ]] && break
    dir="${dir%/*}"
    [[ -z "$dir" ]] && dir="/"
  done
fi
[[ -n "$profile" ]] || exit 0

# ------------------------------------------------------------------- versions
# /nix/store/<hash>-<pname>-<version>/bin/<x>  ->  <version>
store_version() {
  local target base
  target="$(readlink "$profile/bin/$1" 2>/dev/null)"
  # some packages install a wrapper file rather than a direct symlink
  [[ "$target" == /nix/store/* ]] || target="$(readlink -f "$profile/bin/$1" 2>/dev/null)"
  [[ "$target" == /nix/store/* ]] || return 1
  base="${target#/nix/store/}"
  base="${base%%/*}"   # <hash>-<pname>-<version>
  base="${base#*-}"    # <pname>-<version>
  [[ "$base" =~ ([0-9][0-9A-Za-z.+_]*)$ ]] || return 1
  printf '%s' "${BASH_REMATCH[1]}"
}

# keep the first N dot-separated components of a version
short_version() {
  local v="$1" n="$2" out="" i
  for ((i = 0; i < n; i++)); do
    out+="${out:+.}${v%%.*}"
    [[ "$v" == *.* ]] || break
    v="${v#*.}"
  done
  printf '%s' "$out"
}

# ---------------------------------------------------------------------- table
# binary | label | icon | tmux colour | components shown in --tmux
# Order here is the display order; anything the profile does not provide is skipped,
# so adding a language to devenv.nix is enough to make it appear.
tools=(
  "dotnet|.NET|❖|81|1"
  "node|node|⬢|82|1"
  "bun|bun|◍|215|2"
  "deno|deno|◆|82|1"
  "python3|py|🐍|228|2"
  "ruby|ruby|◈|203|2"
  "go|go|◐|81|2"
  "rustc|rust|⚙|208|2"
  "java|jdk|☕|167|1"
  "pwsh|pwsh|❯|69|2"
  "terraform|tf|⬡|141|2"
  "az|az|☁|39|2"
  "scw|scw|▲|177|2"
  "psql|pg|◗|110|1"
)

out=""
seg_bg=()   # powerline needs each segment's neighbour, so collect before rendering
seg_txt=()
for entry in "${tools[@]}"; do
  IFS='|' read -r bin label icon colour precision <<< "$entry"
  version="$(store_version "$bin")" || continue
  case "$format" in
    tmux)
      out+="#[fg=colour${colour}] ${icon} ${label} $(short_version "$version" "$precision")  "
      ;;
    powerline)
      seg_bg+=("$colour")
      seg_txt+=(" ${icon} ${label} $(short_version "$version" "$precision") ")
      out="x"   # just a non-empty marker for the guard below
      ;;
    *)
      out+="${out:+ · }${label} ${version}"
      ;;
  esac
done

# Extras describe tools Nix does not provide, so they are appended verbatim rather
# than looked up in the store. `${extras[@]+…}` guards the empty-array expansion,
# which is an error under `set -u` on bash 3.2.
for entry in ${extras[@]+"${extras[@]}"}; do
  IFS='|' read -r icon label value colour <<< "$entry"
  [[ -n "${value:-}" ]] || continue
  case "$format" in
    tmux)      out+="#[fg=colour${colour}] ${icon} ${label} ${value}  " ;;
    powerline) seg_bg+=("$colour"); seg_txt+=(" ${icon} ${label} ${value} "); out="x" ;;
    *)         out+="${out:+ · }${label} ${value}" ;;
  esac
done

[[ -n "$out" ]] || exit 0

case "$format" in
  tmux)
    # ❄ marks the versions as coming from the Nix env rather than project manifests
    printf '#[fg=colour111] ❄ %s' "$out"
    ;;
  powerline)
    # Agnoster-style bar: each segment is a solid background, and the  is drawn in
    # the *previous* segment's colour on the *next* segment's background so the blocks
    # interlock. The glyph is written literally rather than as $'' — macOS still
    # ships bash 3.2, which does not understand \u escapes.
    esc=$(printf '\033')
    sep=""
    fg_dark="${esc}[38;5;232m"   # near-black text; every colour in the table is light
    line="${esc}[48;5;111m${fg_dark} ❄ "
    n=${#seg_bg[@]}
    prev=111
    for ((i = 0; i < n; i++)); do
      bg="${seg_bg[i]}"
      line+="${esc}[48;5;${bg}m${esc}[38;5;${prev}m${sep}${fg_dark}${seg_txt[i]}"
      prev="$bg"
    done
    # close: reset the background first, so the final  fades into the terminal
    line+="${esc}[49m${esc}[38;5;${prev}m${sep}${esc}[0m"
    printf '%s' "$line"
    ;;
  *)
    printf '%s' "$out"
    ;;
esac
